# THC Academy staging environment template
# Copy values into your deployment secret/configuration system. Do not commit real secrets.

NODE_ENV=staging
ACADEMY_PORT=4173
ACADEMY_PREVIEW_DRAFTS=1
PORT=8787

# Generate a random value of at least 32 characters for staging admin diagnostics.
THC_API_ADMIN_TOKEN=replace-with-random-staging-secret-at-least-32-characters

# Production persistence/signing variables are intentionally omitted here because
# production adapters and issuer signing are still gated in registry/system-readiness.json.


# Secure operational assessment integration test configuration.
# Use staging-only secret-manager values; never commit real keys or operational exam content.
THC_SECURE_ASSESSMENT_SECURITY_CONTROLS_JSON={"accessControlModel":"least-privilege-rbac","leastPrivilegeAccess":true,"privilegedAccessAudited":true,"encryptionInTransit":true,"encryptionAtRest":true,"backupRecoveryDefined":true,"keyManagementSeparated":true,"environmentSeparated":true,"publicRepositoryMaterialExcluded":true}
THC_SECURE_ASSESSMENT_AUDIT_HMAC_KEY=replace-with-random-staging-secret-at-least-32-characters
