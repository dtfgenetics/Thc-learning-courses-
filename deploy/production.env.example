# THC Academy production environment template.
# Copy these names into the hosting platform's secret/environment manager.
# Never commit real database URLs, HMAC keys, signing keys, or identity credentials.

NODE_ENV=production
THC_SERVICE=combined
PORT=8787

THC_PUBLIC_BASE_URL=https://academy.example.com
THC_REQUIRED_SCHEMA_VERSION=7

# Learner/runtime PostgreSQL boundary.
THC_PERSISTENCE_ADAPTER_MODULE=./apps/api/src/postgres-production-adapter.mjs
THC_POSTGRES_POOL_MODULE=./deploy/postgres-pool-provider.mjs
THC_POSTGRES_DATABASE_URL=postgresql://runtime_user:replace-me@runtime-db.example.com:5432/thc_academy?sslmode=require
THC_POSTGRES_POOL_MAX=10
THC_POSTGRES_CONNECTION_TIMEOUT_MS=10000
THC_POSTGRES_IDLE_TIMEOUT_MS=30000

# OIDC/OAuth access-token verification. Use either THC_AUTH_JWKS_URL or
# THC_AUTH_JWKS_JSON. Do not use user-editable metadata for authorization.
THC_AUTH_ADAPTER_MODULE=./deploy/oidc-jwt-auth-adapter.mjs
THC_AUTH_ISSUER=https://identity.example.com
THC_AUTH_AUDIENCE=thc-academy
THC_AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
THC_AUTH_CLOCK_SKEW_SECONDS=60

# Isolated private operational assessment database. These credentials MUST
# differ from THC_POSTGRES_DATABASE_URL and must never contain public bank data.
THC_SECURE_ASSESSMENT_STORE_MODULE=./apps/api/src/postgres-secure-assessment-store.mjs
THC_SECURE_ASSESSMENT_POSTGRES_POOL_MODULE=./deploy/secure-postgres-pool-provider.mjs
THC_SECURE_ASSESSMENT_DATABASE_URL=postgresql://secure_exam_user:replace-me@secure-db.example.com:5432/thc_secure_assessment?sslmode=require
THC_SECURE_ASSESSMENT_POSTGRES_POOL_MAX=5
THC_SECURE_ASSESSMENT_POSTGRES_CONNECTION_TIMEOUT_MS=10000
THC_SECURE_ASSESSMENT_POSTGRES_IDLE_TIMEOUT_MS=30000
THC_SECURE_ASSESSMENT_SECURITY_CONTROLS_JSON={"accessControlModel":"least-privilege-rbac","leastPrivilegeAccess":true,"privilegedAccessAudited":true,"encryptionInTransit":true,"encryptionAtRest":true,"backupRecoveryDefined":true,"keyManagementSeparated":true,"environmentSeparated":true,"publicRepositoryMaterialExcluded":true}
THC_SECURE_ASSESSMENT_AUDIT_HMAC_KEY=replace-with-random-secret-at-least-32-characters

# Credential signing intentionally stays unset until the managed signing
# provider and credential-release authorization are approved.
# THC_CREDENTIAL_SIGNER_MODULE=./deploy/managed-credential-signer.mjs
