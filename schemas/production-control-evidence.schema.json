{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/production-control-evidence.schema.json",
  "title": "THC Academy Production Control Evidence",
  "type": "object",
  "required": [
    "id",
    "controlId",
    "status",
    "environment",
    "observedAt",
    "authorityId",
    "summary",
    "evidenceRefs",
    "findingsDispositioned"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PRODEVID-[A-Z0-9-]+$"
    },
    "controlId": {
      "enum": [
        "production-postgres",
        "admin-mfa",
        "row-level-authorization",
        "security-review",
        "practical-submission-workflow",
        "staging-environment",
        "production-environment",
        "backup-restore",
        "monitoring-alerting",
        "issuer-identity",
        "credential-signing",
        "revocation-persistence",
        "secure-assessment-store"
      ]
    },
    "status": {
      "enum": [
        "in-progress",
        "evidence-complete",
        "approved",
        "revision-required",
        "invalidated"
      ]
    },
    "environment": {
      "enum": [
        "staging",
        "production",
        "cross-environment"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authorityId": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "findingsDispositioned": {
      "type": "boolean"
    },
    "deploymentIdentity": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "serviceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "buildId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{40,64}$"
        },
        "schemaVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string",
          "number",
          "null"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
