{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/performance-assessment.schema.json",
  "title": "THC Academy Performance Assessment",
  "type": "object",
  "required": ["id", "title", "version", "status", "purpose", "assessmentType", "role", "jobTasks", "competencies", "deliveryModes", "evidenceOutputs", "scoring", "passingStandard", "criticalErrors", "sourceDocument"],
  "properties": {
    "id": {"type": "string", "pattern": "^(PRACTICAL|CAPSTONE)-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "approved", "published", "superseded", "retired"]},
    "purpose": {"enum": ["formative", "summative", "credential"]},
    "assessmentType": {"enum": ["practical", "capstone"]},
    "role": {"type": "string", "pattern": "^ROLE-[A-Z0-9-]+$"},
    "jobTasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"}},
    "competencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"}},
    "deliveryModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["simulation", "virtual-facility", "supervised-lab", "workplace-equivalent"]}},
    "evidenceOutputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "scoring": {
      "type": "object",
      "required": ["totalPoints", "domains"],
      "properties": {
        "totalPoints": {"type": "integer", "minimum": 1},
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "points"],
            "properties": {
              "name": {"type": "string", "minLength": 3},
              "points": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "passingStandard": {
      "type": "object",
      "required": ["minimumPercent", "noCriticalErrors"],
      "properties": {
        "minimumPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "noCriticalErrors": {"const": true}
      },
      "additionalProperties": false
    },
    "criticalErrors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "sourceDocument": {"type": "string", "pattern": "^docs/academy-v2/practicals/.+\\.md$"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
