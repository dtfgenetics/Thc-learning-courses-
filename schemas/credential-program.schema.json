{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/credential-program.schema.json",
  "title": "THC Academy Professional Credential Program",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "status",
    "credentialType",
    "occupationalClaim",
    "proficiencyTarget",
    "requiredCourses",
    "competencies",
    "assessmentModel",
    "validation"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^CREDPROG-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "validated", "approved", "published", "superseded", "retired"]},
    "credentialType": {"const": "professional-credential"},
    "occupationalClaim": {"type": "string", "minLength": 30},
    "targetRoles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "proficiencyTarget": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["awareness", "foundational", "applied", "operational", "diagnostic", "lead"]}
    },
    "prerequisiteCertificates": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CERT-[A-Z0-9-]+$"}
    },
    "prerequisiteCredentials": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CREDPROG-[A-Z0-9-]+$"}
    },
    "requiredCourses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^COURSE-[A-Z0-9-]+$"}
    },
    "electiveCourses": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^COURSE-[A-Z0-9-]+$"}
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"}
    },
    "resourceMappings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(RES|THC-C)[A-Z0-9-]+$"}
    },
    "concentrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^CONC-[A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 3},
          "requiredCourses": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^COURSE-[A-Z0-9-]+$"}
          }
        },
        "additionalProperties": false
      }
    },
    "assessmentModel": {
      "type": "object",
      "required": ["courseTests", "credentialAssessment", "performanceEvidence", "standardSettingStatus"],
      "properties": {
        "courseTests": {"type": "boolean"},
        "credentialAssessment": {"type": "string", "pattern": "^ASSESS-[A-Z0-9-]+$"},
        "performanceEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "capstone": {"type": ["string", "null"], "pattern": "^CAPSTONE-[A-Z0-9-]+$"},
        "passingRule": {"type": "string", "minLength": 10},
        "standardSettingStatus": {"enum": ["not-started", "provisional", "validated"]},
        "noCriticalErrorsRequired": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["jobTaskAnalysis", "smeEmployerValidation", "assessmentReview"],
      "properties": {
        "jobTaskAnalysis": {"enum": ["not-started", "draft", "review", "validated"]},
        "smeEmployerValidation": {"enum": ["not-started", "draft", "review", "validated"]},
        "assessmentReview": {"enum": ["not-started", "draft", "review", "validated"]},
        "accessibilityReview": {"enum": ["not-started", "draft", "review", "validated"]}
      },
      "additionalProperties": false
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "renewalRequired": {"type": "boolean"},
        "renewalPeriodMonths": {"type": ["integer", "null"], "minimum": 1},
        "continuingEducationRequired": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 10}}
  },
  "additionalProperties": false
}
