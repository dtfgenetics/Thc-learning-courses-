{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://academy.dtfseeds.com/schemas/glossary-entry.schema.json",
  "title":"THC Academy Glossary Entry",
  "type":"object",
  "required":["id","term","definition","domain","status","version","references","relatedEncyclopedia"],
  "properties":{
    "id":{"type":"string","pattern":"^GLOSS-[A-Z0-9-]+$"},
    "term":{"type":"string","minLength":2},
    "definition":{"type":"string","minLength":40},
    "domain":{"type":"string","minLength":2},
    "status":{"enum":["draft","review","approved","published","superseded","retired"]},
    "version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "references":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^REF-"},"uniqueItems":true},
    "relatedEncyclopedia":{"type":"array","items":{"type":"string","pattern":"^ENC-"},"uniqueItems":true}
  },
  "additionalProperties":false
}
