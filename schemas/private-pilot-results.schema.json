{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/private-pilot-results.schema.json",
  "title": "THC Academy Private Pilot Results Input",
  "type": "object",
  "required": ["cohortId", "analystId", "responses"],
  "properties": {
    "cohortId": {"type": "string", "minLength": 3, "maxLength": 120, "pattern": "^[A-Za-z0-9._-]+$"},
    "analystId": {"type": "string", "minLength": 3, "maxLength": 120},
    "completedAt": {"type": "string", "format": "date-time"},
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["participantId", "itemId", "itemVersion", "correct", "responseTimeSeconds", "criterionScoreExcludingItem"],
        "properties": {
          "participantId": {"type": "string", "minLength": 1, "maxLength": 200},
          "itemId": {"type": "string", "pattern": "^ITEM-[A-Z0-9-]+$"},
          "itemVersion": {"type": "integer", "minimum": 1},
          "selectedChoiceIndex": {"type": ["integer", "null"], "minimum": 0},
          "correct": {"type": "boolean"},
          "omitted": {"type": "boolean"},
          "responseTimeSeconds": {"type": "number", "minimum": 0},
          "responseTimeAnomaly": {"type": "boolean"},
          "criterionScoreExcludingItem": {"type": "number", "minimum": 0, "maximum": 1},
          "totalScore": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
