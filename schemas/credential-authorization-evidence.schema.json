{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/credential-authorization-evidence.schema.json",
  "title": "THC Academy Credential Authorization Evidence",
  "type": "object",
  "required": [
    "id",
    "credentialProgramId",
    "credentialProgramVersion",
    "status",
    "authorizedCourses",
    "issuer",
    "signing",
    "verification",
    "revocation",
    "appeals",
    "lifecycle",
    "privacyRetention",
    "productionControls",
    "governance",
    "authorityId",
    "recordedAt",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CREDAUTH-[A-Z0-9-]+$"
    },
    "credentialProgramId": {
      "type": "string",
      "pattern": "^CREDPROG-[A-Z0-9-]+$"
    },
    "credentialProgramVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "evidence-complete",
        "approved",
        "revision-required",
        "suspended",
        "invalidated"
      ]
    },
    "authorizedCourses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "courseId",
          "courseVersion"
        ],
        "properties": {
          "courseId": {
            "type": "string",
            "pattern": "^COURSE-LH-TECH[12]-[0-9]{3}$"
          },
          "courseVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "issuer": {
      "type": "object",
      "required": [
        "issuerId",
        "name",
        "publicUrl",
        "authorityConfirmed"
      ],
      "properties": {
        "issuerId": {
          "type": "string",
          "minLength": 3
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "publicUrl": {
          "type": "string",
          "format": "uri"
        },
        "authorityConfirmed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "signing": {
      "type": "object",
      "required": [
        "managedExternalSignerRequired",
        "keyIdRecorded",
        "privateKeyOutsideRepository",
        "keyRotationProcedureApproved",
        "compromiseResponseApproved"
      ],
      "properties": {
        "managedExternalSignerRequired": {
          "type": "boolean"
        },
        "keyIdRecorded": {
          "type": "boolean"
        },
        "privateKeyOutsideRepository": {
          "type": "boolean"
        },
        "keyRotationProcedureApproved": {
          "type": "boolean"
        },
        "compromiseResponseApproved": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "publicVerificationEnabled",
        "minimumNecessaryProjection",
        "tamperDetectionEnabled",
        "statusLookupSupportsRevocation"
      ],
      "properties": {
        "publicVerificationEnabled": {
          "type": "boolean"
        },
        "minimumNecessaryProjection": {
          "type": "boolean"
        },
        "tamperDetectionEnabled": {
          "type": "boolean"
        },
        "statusLookupSupportsRevocation": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "revocation": {
      "type": "object",
      "required": [
        "policyApproved",
        "authorizedDecisionMakerRequired",
        "reasonRecorded",
        "effectiveDateRecorded",
        "publicStatusUpdated",
        "auditTrailRequired"
      ],
      "properties": {
        "policyApproved": {
          "type": "boolean"
        },
        "authorizedDecisionMakerRequired": {
          "type": "boolean"
        },
        "reasonRecorded": {
          "type": "boolean"
        },
        "effectiveDateRecorded": {
          "type": "boolean"
        },
        "publicStatusUpdated": {
          "type": "boolean"
        },
        "auditTrailRequired": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "appeals": {
      "type": "object",
      "required": [
        "policyApproved",
        "preserveOriginalRecord",
        "independentOrAuthorizedReviewRequired",
        "decisionRecordRequired",
        "secureAnswerDisclosureProhibited"
      ],
      "properties": {
        "policyApproved": {
          "type": "boolean"
        },
        "preserveOriginalRecord": {
          "type": "boolean"
        },
        "independentOrAuthorizedReviewRequired": {
          "type": "boolean"
        },
        "decisionRecordRequired": {
          "type": "boolean"
        },
        "secureAnswerDisclosureProhibited": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "validityPolicyApproved",
        "renewalPolicyApproved",
        "supersessionPolicyApproved",
        "expirationBehaviorDefined"
      ],
      "properties": {
        "validityPolicyApproved": {
          "type": "boolean"
        },
        "renewalPolicyApproved": {
          "type": "boolean"
        },
        "supersessionPolicyApproved": {
          "type": "boolean"
        },
        "expirationBehaviorDefined": {
          "type": "boolean"
        },
        "validityType": {
          "enum": [
            "indefinite",
            "fixed-term"
          ]
        },
        "validityDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "renewalRequired": {
          "type": "boolean"
        },
        "renewalWindowDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "renewalMethod": {
          "enum": [
            "none",
            "reassessment",
            "performance-reassessment",
            "full-recredential"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "privacyRetention": {
      "type": "object",
      "required": [
        "policyApproved",
        "dataMinimization",
        "roleBasedAccess",
        "retentionScheduleApproved",
        "auditTrailRequired",
        "deletionOrDispositionProcedureApproved"
      ],
      "properties": {
        "policyApproved": {
          "type": "boolean"
        },
        "dataMinimization": {
          "type": "boolean"
        },
        "roleBasedAccess": {
          "type": "boolean"
        },
        "retentionScheduleApproved": {
          "type": "boolean"
        },
        "auditTrailRequired": {
          "type": "boolean"
        },
        "deletionOrDispositionProcedureApproved": {
          "type": "boolean"
        },
        "candidateGovernanceControlsVersion": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "productionControls": {
      "type": "object",
      "required": [
        "persistentStoreValidated",
        "authorizationValidated",
        "backupRestoreValidated",
        "monitoringValidated",
        "signingIntegrationValidated",
        "secureAssessmentStoreValidated"
      ],
      "properties": {
        "persistentStoreValidated": {
          "type": "boolean"
        },
        "authorizationValidated": {
          "type": "boolean"
        },
        "backupRestoreValidated": {
          "type": "boolean"
        },
        "monitoringValidated": {
          "type": "boolean"
        },
        "signingIntegrationValidated": {
          "type": "boolean"
        },
        "secureAssessmentStoreValidated": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": [
        "programApproval",
        "assessmentApproval",
        "accessibilityApproval",
        "privacyLegalApproval",
        "securityApproval",
        "organizationalApproval",
        "finalReleaseDecision"
      ],
      "properties": {
        "programApproval": {
          "type": "boolean"
        },
        "assessmentApproval": {
          "type": "boolean"
        },
        "accessibilityApproval": {
          "type": "boolean"
        },
        "privacyLegalApproval": {
          "type": "boolean"
        },
        "securityApproval": {
          "type": "boolean"
        },
        "organizationalApproval": {
          "type": "boolean"
        },
        "finalReleaseDecision": {
          "enum": [
            "pending",
            "approve",
            "reject",
            "suspend"
          ]
        },
        "decisionAuthority": {
          "type": [
            "string",
            "null"
          ]
        },
        "decisionDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "authorityId": {
      "type": "string",
      "minLength": 3
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
