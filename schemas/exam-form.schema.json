{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/exam-form.schema.json",
  "title": "THC Academy Exam Form",
  "type": "object",
  "required": ["id", "assessment", "assessmentVersion", "algorithmVersion", "status", "items", "coverage", "integrityHash"],
  "properties": {
    "id": {"type": "string", "pattern": "^FORM-[A-Z0-9-]+$"},
    "assessment": {"type": "string", "pattern": "^ASSESS-[A-Z0-9-]+$"},
    "assessmentVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "algorithmVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["generated", "presented", "submitted", "scored", "invalidated"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^ITEM-[A-Z0-9-]+$"},
          "version": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["competency", "count"],
        "properties": {
          "competency": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"},
          "count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "seed": {"type": ["string", "null"]},
    "integrityHash": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
