{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/claim.schema.json",
  "title": "THC Academy Scientific Claim",
  "type": "object",
  "required": ["id", "statement", "domain", "status", "version", "evidenceStatus", "references"],
  "properties": {
    "id": {"type": "string", "pattern": "^CLAIM-[A-Z0-9-]+$"},
    "statement": {"type": "string", "minLength": 10},
    "domain": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review", "approved", "published", "superseded", "retired"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "evidenceStatus": {"enum": ["needs-evidence", "evidence-collected", "reviewed", "disputed", "superseded"]},
    "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supportsCompetencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supportsLessons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reviewDueAt": {"type": ["string", "null"], "format": "date"}
  },
  "additionalProperties": false
}
