{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/certification-gate-evidence.schema.json",
  "title": "THC Academy Certification Gate Evidence",
  "type": "object",
  "required": [
    "id",
    "courseId",
    "courseVersion",
    "gate",
    "status",
    "authorityId",
    "recordedAt",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CGE-[A-Z0-9-]+$"
    },
    "courseId": {
      "type": "string",
      "pattern": "^COURSE-LH-TECH[12]-[0-9]{3}$"
    },
    "courseVersion": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "enum": [
        "exactVersionHumanAssessmentReview",
        "pilotExecution",
        "itemAnalysis",
        "practicalAssessorCalibration",
        "accessibilityUxHumanReview",
        "standardSetting",
        "secureOperationalFormReadiness",
        "occupationalProgramValidation",
        "credentialAuthorization"
      ]
    },
    "status": {
      "enum": [
        "in-progress",
        "evidence-complete",
        "approved",
        "revision-required"
      ]
    },
    "authorityId": {
      "type": "string",
      "minLength": 3
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisionNotes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
