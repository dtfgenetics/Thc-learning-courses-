{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/issued-credential.schema.json",
  "title": "THC Academy Issued Credential Record",
  "type": "object",
  "required": ["id", "credentialDefinition", "credentialVersion", "subjectId", "status", "issuedAt", "verificationId", "assessmentEvidence", "issuer", "integrityHash"],
  "properties": {
    "id": {"type": "string", "pattern": "^(TEST-)?CREDENTIAL-[A-Z0-9-]+$"},
    "credentialDefinition": {"type": "string", "pattern": "^CRED-[A-Z0-9-]+$"},
    "credentialVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "subjectId": {"type": "string", "minLength": 3},
    "status": {"enum": ["test-issued", "issued", "valid", "superseded", "expired", "revoked"]},
    "issuedAt": {"type": "string", "format": "date-time"},
    "verificationId": {"type": "string", "minLength": 8},
    "assessmentEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assessmentId", "scorePercent", "status"],
        "properties": {
          "assessmentId": {"type": "string", "pattern": "^ASSESS-[A-Z0-9-]+$"},
          "scorePercent": {"type": "number", "minimum": 0, "maximum": 100},
          "status": {"const": "passed"}
        },
        "additionalProperties": false
      }
    },
    "issuer": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string"}
      },
      "additionalProperties": false
    },
    "disclaimer": {"type": "string"},
    "integrityHash": {"type": "string", "minLength": 32}
  },
  "additionalProperties": false
}
