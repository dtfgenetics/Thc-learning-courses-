{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/applied-learning-event.schema.json",
  "title": "THC Applied Learning Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "timestamp",
    "kind",
    "subjectId",
    "source",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ALEVT-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "plant-state",
        "environment",
        "root-zone",
        "observation",
        "measurement",
        "evidence",
        "mechanism",
        "hypothesis",
        "intervention",
        "outcome",
        "equipment"
      ]
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "fixture",
        "learner",
        "sensor",
        "simulation",
        "instructor",
        "system"
      ]
    },
    "competencyIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "objectiveIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "claimIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "referenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "payload": {
      "type": "object"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "code"
        ],
        "properties": {
          "type": {
            "enum": [
              "data-quality",
              "instructional",
              "scoring",
              "accessibility"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
