{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/applied-learning-differential.schema.json",
  "title": "THC Applied Learning Differential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "title",
    "summary",
    "observedPattern",
    "competencyIds",
    "referenceIds",
    "canonicalSources",
    "hypotheses",
    "discriminatingEvidence",
    "boundary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ALDIFF-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "retired"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "observedPattern": {
      "type": "string"
    },
    "competencyIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "referenceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "canonicalSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "whyPlausible",
          "evidenceThatRaisesConfidence",
          "evidenceThatLowersConfidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "whyPlausible": {
            "type": "string"
          },
          "evidenceThatRaisesConfidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceThatLowersConfidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "discriminatingEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "boundary": {
      "type": "string"
    },
    "review": {
      "type": "object"
    }
  }
}
