{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/review-record.schema.json",
  "title": "THC Academy Review Note",
  "description": "Optional editable review metadata. Review notes do not control publication, editing, assessment availability, or release status.",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "objectId": {"type": "string"},
    "objectVersion": {"type": ["string", "integer", "null"]},
    "reviewType": {"type": "string"},
    "status": {"type": "string"},
    "reviewerId": {"type": ["string", "null"]},
    "reviewedAt": {"type": ["string", "null"]},
    "notes": {"type": "string"},
    "evidenceChecked": {"type": "array", "items": {} }
  },
  "additionalProperties": true
}
