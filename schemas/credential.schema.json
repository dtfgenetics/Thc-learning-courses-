{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/credential.schema.json",
  "title": "THC Academy Credential Definition",
  "type": "object",
  "required": ["id", "title", "version", "status", "course", "eligibility"],
  "properties": {
    "id": {"type": "string", "pattern": "^CRED-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "publicDesignation": {"type": "string", "minLength": 3},
    "credentialType": {"enum": ["academy-certificate", "academy-certification", "personnel-certification"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "approved", "published", "superseded", "retired"]},
    "course": {"type": "string", "pattern": "^COURSE-[A-Z0-9-]+$"},
    "courseVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "credentialProgram": {"type": "string", "pattern": "^CREDPROG-[A-Z0-9-]+$"},
    "role": {"type": "string", "pattern": "^ROLE-[A-Z0-9-]+$"},
    "issuer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 3},
        "verificationPath": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    },
    "level": {"enum": ["foundational", "intermediate", "advanced", "professional"]},
    "publicDescription": {"type": "string", "minLength": 10},
    "intendedAudience": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "competenciesDemonstrated": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"}},
    "assessmentModel": {
      "type": "object",
      "properties": {
        "knowledgeAssessment": {"type": "string", "minLength": 20},
        "configuredPassingScorePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "thresholdStatus": {"enum": ["provisional", "validation-pending", "validated"]},
        "standardSettingStatus": {"enum": ["not-started", "planned", "pilot-data-pending", "analysis-pending", "complete"]},
        "retakePolicy": {"type": "string", "minLength": 20},
        "completionEvidence": {"type": "string", "minLength": 20},
        "performanceEvidence": {"type": "string", "minLength": 20},
        "highIntegrityAssessmentRequired": {"type": "boolean"},
        "protectedItemStoreRequired": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "employmentUse": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "standardsAlignment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["standard", "relationship"],
        "properties": {
          "standard": {"type": "string", "minLength": 3},
          "relationship": {"type": "string", "minLength": 10},
          "claim": {"type": "string", "minLength": 10}
        },
        "additionalProperties": false
      }
    },
    "externalAccreditation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not-claimed", "preparing", "applicant", "accredited"]},
        "body": {"type": "string", "minLength": 2},
        "scope": {"type": "string", "minLength": 5}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {"enum": ["planned", "disabled", "enabled"]},
        "publicVerificationEnabled": {"type": "boolean"},
        "publicFields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "lifecycle": {
      "type": "object",
      "properties": {
        "validityType": {"enum": ["indefinite", "fixed-term"]},
        "validityDays": {"type": "integer", "minimum": 1},
        "renewalRequired": {"type": "boolean"},
        "renewalWindowDays": {"type": "integer", "minimum": 1},
        "renewalMethod": {"enum": ["none", "reassessment", "performance-reassessment", "full-recredential"]},
        "supersessionPolicy": {"enum": ["retain-validity", "require-reissue"]}
      },
      "allOf": [
        {
          "if": {"properties": {"validityType": {"const": "fixed-term"}}},
          "then": {"required": ["validityDays"]}
        },
        {
          "if": {"properties": {"renewalRequired": {"const": true}}},
          "then": {"required": ["renewalWindowDays"]}
        }
      ],
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "certificationUseStatus": {"enum": ["not-authorized", "validation-pending", "authorized", "suspended", "retired"]},
        "humanReviewStatus": {"enum": ["not-started", "in-progress", "complete"]},
        "accessibilityReviewStatus": {"enum": ["not-started", "in-progress", "complete"]},
        "pilotStatus": {"enum": ["not-started", "planned", "collecting", "analysis-pending", "complete"]},
        "standardSettingStatus": {"enum": ["not-started", "planned", "pilot-data-pending", "analysis-pending", "complete"]},
        "releaseApprovalStatus": {"enum": ["not-requested", "pending", "approved", "rejected"]}
      },
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "required": ["requiredAssessments", "minimumPassingScorePercent"],
      "properties": {
        "requireCourseCompletion": {"type": "boolean"},
        "requiredCourseCompletions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^COURSE-[A-Z0-9-]+$"}},
        "requiredAssessments": {"type": "array", "items": {"type": "string", "pattern": "^ASSESS-[A-Z0-9-]+$"}},
        "minimumPassingScorePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "requiredPerformanceAssessments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(PRACTICAL|CAPSTONE)-[A-Z0-9-]+$"}},
        "requireNoCriticalErrors": {"type": "boolean"},
        "requireVerifiedPerformanceEvidence": {"type": "boolean"},
        "requiredPortfolioArtifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
