{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/credential.schema.json",
  "title": "THC Academy Credential Definition",
  "type": "object",
  "required": ["id", "title", "version", "status", "course", "eligibility"],
  "properties": {
    "id": {"type": "string", "pattern": "^CRED-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "approved", "published", "superseded", "retired"]},
    "course": {"type": "string", "pattern": "^COURSE-[A-Z0-9-]+$"},
    "role": {"type": "string", "pattern": "^ROLE-[A-Z0-9-]+$"},
    "publicDescription": {"type": "string", "minLength": 10},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "lifecycle": {
      "type": "object",
      "required": ["validityType", "renewalRequired", "renewalMethod", "supersessionPolicy"],
      "properties": {
        "validityType": {"enum": ["indefinite", "fixed-term"]},
        "validityDays": {"type": "integer", "minimum": 1},
        "renewalRequired": {"type": "boolean"},
        "renewalWindowDays": {"type": "integer", "minimum": 1},
        "renewalMethod": {"enum": ["none", "reassessment", "performance-reassessment", "full-recredential"]},
        "supersessionPolicy": {"enum": ["retain-validity", "require-reissue"]}
      },
      "allOf": [
        {
          "if": {"properties": {"validityType": {"const": "fixed-term"}}, "required": ["validityType"]},
          "then": {"required": ["validityDays"]}
        },
        {
          "if": {"properties": {"renewalRequired": {"const": true}}, "required": ["renewalRequired"]},
          "then": {"required": ["renewalWindowDays"]}
        }
      ],
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "required": ["requiredAssessments", "minimumPassingScorePercent"],
      "properties": {
        "requiredAssessments": {"type": "array", "items": {"type": "string", "pattern": "^ASSESS-[A-Z0-9-]+$"}},
        "minimumPassingScorePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "requiredPerformanceAssessments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(PRACTICAL|CAPSTONE)-[A-Z0-9-]+$"}},
        "requireNoCriticalErrors": {"type": "boolean"},
        "requireVerifiedPerformanceEvidence": {"type": "boolean"},
        "requiredPortfolioArtifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
