{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/occupational-program-validation-evidence.schema.json",
  "title": "THC Academy Occupational Program Validation Evidence",
  "type": "object",
  "required": [
    "id",
    "credentialProgramId",
    "credentialProgramVersion",
    "status",
    "authorizedCourses",
    "technicalCurriculumReview",
    "jobTaskAnalysis",
    "smeEmployerValidation",
    "assessmentBlueprint",
    "performanceValidation",
    "authorityId",
    "recordedAt",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OCCVAL-[A-Z0-9-]+$"
    },
    "credentialProgramId": {
      "type": "string",
      "pattern": "^CREDPROG-[A-Z0-9-]+$"
    },
    "credentialProgramVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "in-progress",
        "evidence-complete",
        "approved",
        "revision-required",
        "invalidated"
      ]
    },
    "authorizedCourses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "courseId",
          "courseVersion"
        ],
        "properties": {
          "courseId": {
            "type": "string",
            "pattern": "^COURSE-LH-TECH[12]-[0-9]{3}$"
          },
          "courseVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "technicalCurriculumReview": {
      "type": "object",
      "required": [
        "allCurrentCourseVersionsReviewed",
        "contentScopeAndRoleBoundariesReviewed",
        "scientificTechnicalConcernsResolvedOrDispositioned"
      ],
      "properties": {
        "allCurrentCourseVersionsReviewed": {
          "type": "boolean"
        },
        "contentScopeAndRoleBoundariesReviewed": {
          "type": "boolean"
        },
        "scientificTechnicalConcernsResolvedOrDispositioned": {
          "type": "boolean"
        },
        "reviewerCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "jobTaskAnalysis": {
      "type": "object",
      "required": [
        "validated",
        "populationDefined",
        "taskDomainCoverageReviewed",
        "currencyReviewed"
      ],
      "properties": {
        "validated": {
          "type": "boolean"
        },
        "populationDefined": {
          "type": "boolean"
        },
        "taskDomainCoverageReviewed": {
          "type": "boolean"
        },
        "currencyReviewed": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "smeEmployerValidation": {
      "type": "object",
      "required": [
        "completed",
        "roleRepresentativenessReviewed",
        "criticalTasksReviewed",
        "scopeOfPracticeReviewed"
      ],
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "roleRepresentativenessReviewed": {
          "type": "boolean"
        },
        "criticalTasksReviewed": {
          "type": "boolean"
        },
        "scopeOfPracticeReviewed": {
          "type": "boolean"
        },
        "panelistCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "assessmentBlueprint": {
      "type": "object",
      "required": [
        "weightsFinalized",
        "competencyCoverageApproved",
        "criticalContentRepresentationApproved",
        "cognitiveDemandApproved"
      ],
      "properties": {
        "weightsFinalized": {
          "type": "boolean"
        },
        "competencyCoverageApproved": {
          "type": "boolean"
        },
        "criticalContentRepresentationApproved": {
          "type": "boolean"
        },
        "cognitiveDemandApproved": {
          "type": "boolean"
        },
        "blueprintVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "performanceValidation": {
      "type": "object",
      "required": [
        "required",
        "practicalsExpected",
        "practicalsValidated",
        "capstoneRequired",
        "capstoneValidated",
        "criticalDecisionCoverageApproved",
        "unresolvedCriticalIssues"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "practicalsExpected": {
          "type": "integer",
          "minimum": 0
        },
        "practicalsValidated": {
          "type": "integer",
          "minimum": 0
        },
        "capstoneRequired": {
          "type": "boolean"
        },
        "capstoneValidated": {
          "type": "boolean"
        },
        "criticalDecisionCoverageApproved": {
          "type": "boolean"
        },
        "unresolvedCriticalIssues": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "authorityId": {
      "type": "string",
      "minLength": 3
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
