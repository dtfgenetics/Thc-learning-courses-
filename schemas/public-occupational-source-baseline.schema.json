{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/public-occupational-source-baseline.schema.json",
  "title": "THC Academy Public Occupational Source Baseline",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "asOf",
    "status",
    "purpose",
    "integrityBoundary",
    "programs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^THC-CERT-OCCUPATIONAL-SOURCE-BASELINE-[0-9]+$"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "supporting-baseline"
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "integrityBoundary": {
      "type": "string",
      "minLength": 40
    },
    "programs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "credentialProgramId",
          "credentialProgramVersion",
          "sourceIds",
          "interpretation",
          "taskFamilies"
        ],
        "properties": {
          "credentialProgramId": {
            "enum": [
              "CREDPROG-CULT-TECH-I-001",
              "CREDPROG-CULT-TECH-II-001"
            ]
          },
          "credentialProgramVersion": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^REF-[A-Z0-9-]+$"
            }
          },
          "interpretation": {
            "type": "string",
            "minLength": 40
          },
          "taskFamilies": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "sourceSupport",
                "courseMappings",
                "publicOccupationalBasis",
                "cannabisAdaptationQuestions"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^TECH[12]-[A-Z0-9-]+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 5
                },
                "sourceSupport": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^REF-[A-Z0-9-]+$"
                  }
                },
                "courseMappings": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^COURSE-LH-TECH[12]-[0-9]{3}$"
                  }
                },
                "publicOccupationalBasis": {
                  "type": "string",
                  "minLength": 30
                },
                "cannabisAdaptationQuestions": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 20
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
