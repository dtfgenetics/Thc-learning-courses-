{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/applied-learning-tool.schema.json",
  "title": "THC Applied Learning Tool",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "kind",
    "title",
    "summary",
    "competencyIds",
    "referenceIds",
    "canonicalSources",
    "steps",
    "fields",
    "boundary",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ALTOOL-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "retired"
      ]
    },
    "kind": {
      "enum": [
        "blueprint",
        "calibration",
        "timeline-atlas",
        "flight-recorder",
        "incident-report",
        "cause-chain"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "competencyIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "objectiveIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "referenceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "canonicalSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instruction"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "type",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "number",
              "text",
              "choice",
              "timestamp"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "configuration": {
      "type": "object"
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanTechnicalReviewRequired",
        "accessibilityReviewRequired",
        "credentialUseAuthorized"
      ],
      "properties": {
        "humanTechnicalReviewRequired": {
          "type": "boolean"
        },
        "accessibilityReviewRequired": {
          "type": "boolean"
        },
        "credentialUseAuthorized": {
          "type": "boolean"
        }
      }
    }
  }
}
