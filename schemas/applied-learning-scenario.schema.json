{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/applied-learning-scenario.schema.json",
  "title": "THC Applied Learning Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "title",
    "summary",
    "subjectId",
    "events",
    "allowedActions",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ALSCN-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "retired"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "competencyIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "objectiveIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "applied-learning-event.schema.json"
      }
    },
    "allowedActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "when": {
            "type": "object"
          },
          "then": {
            "type": "object"
          }
        }
      }
    },
    "instructor": {
      "type": "object"
    }
  }
}
