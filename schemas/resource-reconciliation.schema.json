{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/resource-reconciliation.schema.json",
  "title": "THC legacy resource reconciliation registry",
  "type": "object",
  "required": ["schemaVersion", "id", "source", "architecture", "summary", "records"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"const": "legacy-420-resource-reconciliation"},
    "source": {
      "type": "object",
      "required": ["fileName", "sha256", "sheet", "importedAt"],
      "properties": {
        "fileName": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sheet": {"const": "Course Production"},
        "importedAt": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": ["legacyObjectType", "canonicalObjectType", "credentialBearing"],
      "properties": {
        "legacyObjectType": {"const": "misclassified-course-record"},
        "canonicalObjectType": {"const": "comprehensive-educational-resource"},
        "credentialBearing": {"const": false}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["total", "confirmedReuse", "confirmedUpgrade", "candidateReview", "unmatched", "createRequired"],
      "properties": {
        "total": {"const": 420},
        "confirmedReuse": {"type": "integer", "minimum": 0},
        "confirmedUpgrade": {"type": "integer", "minimum": 0},
        "candidateReview": {"type": "integer", "minimum": 0},
        "unmatched": {"type": "integer", "minimum": 0},
        "createRequired": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 420,
      "maxItems": 420,
      "items": {
        "type": "object",
        "required": ["legacyId", "legacyTitle", "level", "domainId", "domain", "legacyPrerequisite", "legacyHours", "legacyCredential", "classification", "match"],
        "properties": {
          "legacyId": {"type": "string", "pattern": "^THC-C[0-9]{3}$"},
          "legacyTitle": {"type": "string", "minLength": 3},
          "level": {"type": "integer", "minimum": 1},
          "domainId": {"type": "string", "pattern": "^THC-A[0-9]{2}$"},
          "domain": {"type": "string", "minLength": 2},
          "legacyPrerequisite": {"type": ["string", "null"]},
          "legacyHours": {"type": "number", "exclusiveMinimum": 0},
          "legacyCredential": {"type": "string", "minLength": 2},
          "classification": {"enum": ["reuse", "upgrade", "create", "manual-review"]},
          "match": {
            "type": ["object", "null"],
            "properties": {
              "repository": {"enum": ["dtfgenetics/Thc", "dtfgenetics/Thc-learning-courses-"]},
              "objectType": {"enum": ["encyclopedia-entry", "lesson", "guide", "sop", "tool", "case-study"]},
              "objectId": {"type": "string", "pattern": "^(THC-ENC-[0-9]{3}|LESSON-[A-Z0-9-]+|GUIDE-[A-Z0-9-]+|SOP-[A-Z0-9-]+|TOOL-[A-Z0-9-]+|CASE-[A-Z0-9-]+)$"},
              "title": {"type": "string", "minLength": 3},
              "path": {"type": "string", "minLength": 3},
              "score": {"type": "number", "minimum": 0, "maximum": 1},
              "method": {"enum": ["exact-title", "token-similarity", "content-review"]},
              "status": {"enum": ["confirmed", "candidate"]}
            },
            "required": ["repository", "objectType", "objectId", "title", "path", "score", "method", "status"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
