{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/lesson.schema.json",
  "title": "THC Academy Lesson",
  "type": "object",
  "required": ["id", "title", "version", "status", "competencies", "learningObjectives", "estimatedMinutes", "references"],
  "properties": {
    "id": {"type": "string", "pattern": "^LESSON-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "approved", "published", "superseded", "retired"]},
    "competencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"}},
    "learningObjectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^LO-[A-Z0-9-]+$"}},
    "estimatedMinutes": {"type": "integer", "minimum": 1},
    "references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}},
    "assessment": {"type": ["string", "null"]},
    "content": {
      "type": "object",
      "required": ["overview", "vocabulary", "sections", "commonMistakes", "practicalApplication", "summary"],
      "properties": {
        "overview": {"type": "string", "minLength": 40},
        "vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["term", "definition"],
            "properties": {
              "term": {"type": "string", "minLength": 1},
              "definition": {"type": "string", "minLength": 10}
            },
            "additionalProperties": false
          }
        },
        "sections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["title", "body"],
            "properties": {
              "title": {"type": "string", "minLength": 3},
              "body": {"type": "string", "minLength": 40},
              "references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}}
            },
            "additionalProperties": false
          }
        },
        "workedExamples": {"type": "array", "items": {"type": "string", "minLength": 20}},
        "commonMistakes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 15}},
        "practicalApplication": {"type": "string", "minLength": 40},
        "summary": {"type": "string", "minLength": 40}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
