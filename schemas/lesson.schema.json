{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/lesson.schema.json",
  "title": "THC Academy Lesson",
  "type": "object",
  "required": ["id", "title", "version", "status", "competencies", "learningObjectives", "estimatedMinutes", "references"],
  "properties": {
    "id": {"type": "string", "pattern": "^LESSON-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "approved", "published", "superseded", "retired"]},
    "competencies": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"}},
    "learningObjectives": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^LO-[A-Z0-9-]+$"}},
    "estimatedMinutes": {"type": "integer", "minimum": 1},
    "references": {"type": "array", "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}},
    "assessment": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
