{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/lesson.schema.json",
  "title": "THC Academy Lesson",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "status",
    "competencies",
    "learningObjectives",
    "estimatedMinutes",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LESSON-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "published",
        "superseded",
        "retired"
      ]
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^COMP-[A-Z0-9-]+$"
      }
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^LO-[A-Z0-9-]+$"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REF-[A-Z0-9-]+$"
      }
    },
    "assessment": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "type": "object",
      "required": [
        "overview"
      ],
      "properties": {
        "overview": {
          "type": "string",
          "minLength": 40
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "term",
              "definition"
            ],
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "body"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 3
              },
              "body": {
                "type": "string",
                "minLength": 40
              },
              "references": {
                "$ref": "#/$defs/referenceList"
              }
            },
            "additionalProperties": false
          }
        },
        "workedExamples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 20
          }
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "practicalApplication": {
          "type": "string",
          "minLength": 40
        },
        "summary": {
          "type": "string",
          "minLength": 40
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/richBlock"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "blocks"
          ]
        },
        {
          "required": [
            "vocabulary",
            "sections",
            "commonMistakes",
            "practicalApplication",
            "summary"
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "referenceList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REF-[A-Z0-9-]+$"
      }
    },
    "stepItem": {
      "type": "object",
      "required": [
        "body"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "comparisonSide": {
      "type": "object",
      "required": [
        "label",
        "body"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "documentField": {
      "type": "object",
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "richBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "body"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "body"
          ],
          "properties": {
            "type": {
              "const": "callout"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "tone": {
              "enum": [
                "note",
                "tip",
                "safety",
                "warning",
                "evidence"
              ]
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "src",
            "alt"
          ],
          "properties": {
            "type": {
              "const": "image"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "assetId": {
              "type": "string",
              "minLength": 1
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            },
            "credit": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "title",
            "items"
          ],
          "properties": {
            "type": {
              "const": "steps"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/stepItem"
              }
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "left",
            "right"
          ],
          "properties": {
            "type": {
              "const": "comparison"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "left": {
              "$ref": "#/$defs/comparisonSide"
            },
            "right": {
              "$ref": "#/$defs/comparisonSide"
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "columns",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "title",
            "prompt"
          ],
          "properties": {
            "type": {
              "const": "scenario"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "setting": {
              "type": "string"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "feedback": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "title",
            "instructions"
          ],
          "properties": {
            "type": {
              "const": "activity"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "prompts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "title",
            "fields"
          ],
          "properties": {
            "type": {
              "const": "document"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/documentField"
              }
            },
            "note": {
              "type": "string"
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "title"
          ],
          "properties": {
            "type": {
              "const": "resource"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string"
            },
            "href": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "$ref": "#/$defs/referenceList"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "divider"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
