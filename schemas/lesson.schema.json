{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/lesson.schema.json",
  "title": "THC Academy Lesson",
  "type": "object",
  "required": ["id", "title", "version", "status", "competencies", "learningObjectives", "estimatedMinutes", "references"],
  "properties": {
    "id": {"type": "string", "pattern": "^LESSON-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "approved", "published", "superseded", "retired"]},
    "competencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"}},
    "learningObjectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^LO-[A-Z0-9-]+$"}},
    "estimatedMinutes": {"type": "integer", "minimum": 1},
    "references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}},
    "assessment": {"type": ["string", "null"]},
    "content": {
      "type": "object",
      "required": ["overview", "vocabulary", "sections", "commonMistakes", "practicalApplication", "summary"],
      "properties": {
        "overview": {"type": "string", "minLength": 40},
        "whyItMatters": {"type": "string", "minLength": 20},
        "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "priorKnowledgeRetrieval": {"type": "array", "items": {"type": "string", "minLength": 10}},
        "vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["term", "definition"],
            "properties": {
              "term": {"type": "string", "minLength": 1},
              "definition": {"type": "string", "minLength": 10}
            },
            "additionalProperties": false
          }
        },
        "sections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["title", "body"],
            "properties": {
              "title": {"type": "string", "minLength": 3},
              "body": {"type": "string", "minLength": 40},
              "references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}}
            },
            "additionalProperties": false
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "caption", "altText"],
            "properties": {
              "id": {"type": "string", "minLength": 3},
              "title": {"type": "string", "minLength": 3},
              "caption": {"type": "string", "minLength": 10},
              "altText": {"type": "string", "minLength": 10},
              "assetRef": {"type": ["string", "null"]},
              "references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}}
            },
            "additionalProperties": false
          }
        },
        "workedExamples": {"type": "array", "items": {"type": "string", "minLength": 20}},
        "guidedPractice": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["prompt"],
            "properties": {
              "prompt": {"type": "string", "minLength": 20},
              "steps": {"type": "array", "items": {"type": "string", "minLength": 5}},
              "expectedEvidence": {"type": "string", "minLength": 10},
              "feedbackGuidance": {"type": "string", "minLength": 10}
            },
            "additionalProperties": false
          }
        },
        "decisionScenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scenario", "prompt"],
            "properties": {
              "scenario": {"type": "string", "minLength": 30},
              "prompt": {"type": "string", "minLength": 10},
              "expectedReasoning": {"type": "string", "minLength": 20}
            },
            "additionalProperties": false
          }
        },
        "dataExercises": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["prompt"],
            "properties": {
              "prompt": {"type": "string", "minLength": 20},
              "data": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "calculation": {"type": ["string", "null"]},
              "answerGuidance": {"type": "string", "minLength": 10}
            },
            "additionalProperties": false
          }
        },
        "commonMistakes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 15}},
        "workplaceConnections": {"type": "array", "items": {"type": "string", "minLength": 15}},
        "safetyComplianceNotes": {"type": "array", "items": {"type": "string", "minLength": 15}},
        "practicalApplication": {"type": "string", "minLength": 40},
        "practicalActivities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "instructions"],
            "properties": {
              "title": {"type": "string", "minLength": 3},
              "instructions": {"type": "string", "minLength": 30},
              "evidenceToProduce": {"type": "array", "items": {"type": "string", "minLength": 3}},
              "deliveryModes": {"type": "array", "uniqueItems": true, "items": {"enum": ["simulation", "supervised-lab", "workplace", "paper-data-exercise"]}}
            },
            "additionalProperties": false
          }
        },
        "formativeAssessmentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ASSESS-[A-Z0-9-]+$"}},
        "portfolioEvidence": {"type": "array", "items": {"type": "string", "minLength": 5}},
        "spacedRetrieval": {"type": "array", "items": {"type": "string", "minLength": 10}},
        "furtherReading": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}},
        "evidenceDisclosure": {"type": "string", "minLength": 20},
        "accessibility": {
          "type": "object",
          "properties": {
            "readingOrderNotes": {"type": "string", "minLength": 10},
            "alternativeTextNotes": {"type": "string", "minLength": 10},
            "transcriptRequired": {"type": "boolean"},
            "nonVisualAlternative": {"type": "string", "minLength": 10}
          },
          "additionalProperties": false
        },
        "summary": {"type": "string", "minLength": 40}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
