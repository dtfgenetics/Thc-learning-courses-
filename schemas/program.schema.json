{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/program.schema.json",
  "title": "THC Academy Program",
  "type": "object",
  "required": ["id", "title", "version", "status", "courses"],
  "properties": {
    "id": {"type": "string", "pattern": "^PROGRAM-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "approved", "published", "superseded", "retired"]},
    "courses": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^COURSE-[A-Z0-9-]+$"}}
  },
  "additionalProperties": false
}
