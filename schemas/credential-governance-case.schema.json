{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/credential-governance-case.schema.json",
  "title": "THC Academy Credential Governance Case",
  "type": "object",
  "required": [
    "id",
    "caseType",
    "status",
    "openedAt",
    "subject",
    "events"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CASE-[A-Z0-9-]+$"
    },
    "caseType": {
      "enum": [
        "appeal",
        "complaint",
        "security-incident",
        "credential-correction",
        "revocation-review",
        "accommodation-review",
        "conflict-of-interest"
      ]
    },
    "status": {
      "enum": [
        "open",
        "under-review",
        "on-hold",
        "resolved",
        "closed"
      ]
    },
    "openedAt": {
      "type": "string",
      "format": "date-time"
    },
    "closedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "enum": [
            "candidate",
            "credential-holder",
            "assessor",
            "reviewer",
            "program",
            "assessment",
            "credential"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "confidential": {
      "type": "boolean"
    },
    "relatedProgramId": {
      "type": [
        "string",
        "null"
      ]
    },
    "relatedCredentialId": {
      "type": [
        "string",
        "null"
      ]
    },
    "grounds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "assignedDecisionAuthority": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "secureContentDisclosureAllowed": {
      "const": false
    },
    "preserveOriginalEvidence": {
      "const": true
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "at",
          "actorRole",
          "action"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actorRole": {
            "type": "string",
            "minLength": 2
          },
          "action": {
            "type": "string",
            "minLength": 2
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
