{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/public-authoritative-source-supplements.schema.json",
  "title": "THC Academy Public Authoritative Source Supplements",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "asOf",
    "purpose",
    "integrityBoundary",
    "mappings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^THC-CERT-PUBLIC-AUTHORITATIVE-SOURCE-SUPPLEMENTS-[A-Z0-9-]+$"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "integrityBoundary": {
      "type": "string",
      "minLength": 20
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "courseId",
          "lessonId",
          "lessonVersion",
          "sourceIds",
          "reviewUse"
        ],
        "properties": {
          "courseId": {
            "type": "string",
            "pattern": "^COURSE-LH-TECH[12]-[0-9]{3}$"
          },
          "lessonId": {
            "type": "string",
            "pattern": "^LESSON-[A-Z0-9-]+$"
          },
          "lessonVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^REF-[A-Z0-9-]+$"
            }
          },
          "reviewUse": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
