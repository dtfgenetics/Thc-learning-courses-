{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.dtfseeds.com/schemas/module.schema.json",
  "title": "THC Academy Module",
  "type": "object",
  "required": ["id", "title", "version", "status", "lessons", "competencies"],
  "properties": {
    "id": {"type": "string", "pattern": "^MOD-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "approved", "published", "superseded", "retired"]},
    "lessons": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^LESSON-[A-Z0-9-]+$"}},
    "competencies": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"}},
    "assessment": {"type": ["string", "null"]},
    "description": {"type": "string", "minLength": 1},
    "estimatedMinutes": {"type": "integer", "minimum": 1},
    "learningOutcomes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "extensions": {
      "type": "object",
      "description": "Open namespaced metadata for future instructional, delivery, localization, visual, assessment, or platform needs while preserving validation of the core module contract.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
