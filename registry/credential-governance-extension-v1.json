{
  "schemaVersion": 1,
  "id": "CREDENTIAL-GOVERNANCE-EXTENSION-001",
  "version": "0.1.0",
  "updated": "2026-10-03",
  "status": "draft",
  "appliesTo": [
    "CREDPROG-CULT-TECH-I-001",
    "CREDPROG-CULT-TECH-II-001"
  ],
  "controls": {
    "complaints": {
      "required": true,
      "separateFromAppeals": true,
      "categories": [
        "assessor-conduct",
        "impartiality",
        "testing-conditions",
        "security",
        "privacy",
        "administration",
        "program-practice",
        "other"
      ],
      "preserveOriginalRecord": true,
      "authorizedDecisionMakerRequired": true,
      "auditTrailRequired": true
    },
    "impartiality": {
      "required": true,
      "conflictDeclarationRequired": true,
      "mitigationRequiredBeforeAffectedDecision": true,
      "riskAreas": [
        "authorship-and-approval",
        "assessor-relationship",
        "employer-sponsor-pressure",
        "commercial-pressure",
        "training-certification-coupling",
        "reviewer-conflict"
      ]
    },
    "aiProvenance": {
      "requiredForCredentialBearingObjects": true,
      "humanApprovalRequired": true,
      "finalDecisionAutomationProhibited": [
        "credential-issuance",
        "credential-revocation",
        "appeal-disposition",
        "accommodation-approval",
        "passing-standard-adoption",
        "operational-form-approval",
        "assessor-authorization"
      ]
    },
    "continuingCompetence": {
      "lifecycleStates": [
        "active",
        "expiring",
        "renewed",
        "expired",
        "suspended",
        "revoked",
        "superseded"
      ],
      "renewalIntervalStatus": "not-adopted",
      "acceptableFutureEvidenceTypes": [
        "continuing-education",
        "occupational-practice",
        "update-module",
        "reassessment",
        "re-examination"
      ],
      "doNotInventInterval": true
    },
    "eligibilitySeparation": {
      "educationCertificateDistinctFromProfessionalCertification": true,
      "trainingCompletionAloneDoesNotAuthorizeProfessionalCertification": true,
      "equivalentPreparationPathStatus": "requires-governance-design-and-approval"
    }
  },
  "requiredApprovals": [
    "program",
    "assessment",
    "accessibility",
    "privacy/legal",
    "security",
    "organizational"
  ],
  "operationalUseAuthorized": false,
  "boundary": "Draft governance extension. These controls identify missing professional-certification governance capabilities but do not alter currently approved issuer-policy values or authorize operational credential issuance."
}
