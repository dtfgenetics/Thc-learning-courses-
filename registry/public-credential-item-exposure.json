{
  "schemaVersion": 1,
  "id": "public-credential-item-exposure",
  "updated": "2026-09-20",
  "scope": {
    "path": "content/questions/*.json",
    "selector": {
      "purpose": "credential"
    },
    "appliesToAllMatches": true
  },
  "classification": {
    "publicSource": "keyed-development-blueprint",
    "securityState": "compromised-for-secure-operational-use",
    "operationalUseAllowed": false,
    "activationAllowed": false
  },
  "replacement": {
    "destination": "approved-private-assessment-store-or-delivery-service",
    "newSecureItemMaterialRequired": true,
    "copyPublicKeyedContentUnchanged": false,
    "protectedItemIdsPublished": false,
    "answerKeysPublished": false
  },
  "lineage": {
    "publicReference": "public item id and version may be retained only as declassified development lineage",
    "operationalReference": "protected replacement identifiers and exposure history remain private",
    "publicToOperationalRelationship": "replacement-required-not-promotion"
  },
  "retention": {
    "keepPublicDevelopmentBlueprints": true,
    "reason": "Public copies may remain educational/development examples but are permanently ineligible as secure operational credential items."
  }
}
