  "criticalFailureRules": [
    {
      "id": "CF-TECH2-SAFETY-001",
      "rule": "Knowingly takes an unsafe action or bypasses a required safety boundary during a condition that requires stop, isolation or qualified escalation.",
      "blocksCredentialEvidence": true
    },
    {
      "id": "CF-TECH2-AUTHORITY-001",
      "rule": "Performs an unauthorized high-risk repair, pesticide or chemical-treatment action, unapproved recipe change, or other intervention outside assigned authority.",
      "blocksCredentialEvidence": true
    },
    {
      "id": "CF-TECH2-INTEGRITY-001",
      "rule": "Fabricates, deletes, falsifies or silently overwrites traceability, quality, measurement, genealogy or production evidence to force agreement or hide a discrepancy.",
      "blocksCredentialEvidence": true
    },
    {
      "id": "CF-TECH2-DISPOSITION-001",
      "rule": "Makes an unauthorized product release or disposition decision or knowingly moves material from an active hold without required authorization.",
      "blocksCredentialEvidence": true
    },
    {
      "id": "CF-TECH2-CONTAINMENT-001",
      "rule": "Ignores a clearly identified urgent biosecurity, identity, safety or quality-containment condition or breaks required quarantine handling.",
      "blocksCredentialEvidence": true
    },
    {
      "id": "CF-TECH2-DATA-001",
      "rule": "Takes a major corrective action from data known to be invalid, unverified or materially contradictory without completing the required verification.",
      "blocksCredentialEvidence": true
    },
    {
      "id": "CF-TECH2-SCOPE-001",
      "rule": "Knowingly breaks genealogy or manipulates affected scope, sampling effort or KPI denominator to improve the apparent result after the governing definition is known.",
      "blocksCredentialEvidence": true
    }
  ],
