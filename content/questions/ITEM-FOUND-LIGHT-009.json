{"id":"ITEM-FOUND-LIGHT-009","version":1,"status":"draft","purpose":"summative","competency":"COMP-LIGHT-001","objective":"LO-LIGHT-DLI-003","bloomLevel":"apply","difficulty":"moderate","type":"multiple-choice","stem":"A canopy averages 500 µmol·m⁻²·s⁻¹ for 16 hours. What is the approximate DLI?","choices":["14.4 mol·m⁻²·d⁻¹","28.8 mol·m⁻²·d⁻¹","43.2 mol·m⁻²·d⁻¹","57.6 mol·m⁻²·d⁻¹"],"correct":1,"rationale":"DLI = 500 × 57,600 ÷ 1,000,000 = 28.8 mol·m⁻²·d⁻¹.","references":["REF-LIGHT-001"]}
