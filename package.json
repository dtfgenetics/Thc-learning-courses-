{
  "name": "thc-learning-courses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "schema:validate": "node scripts/validate-json-schemas.mjs",
    "validate": "node scripts/validate-curriculum.mjs",
    "registry:build": "node scripts/build-global-registry.mjs --write",
    "registry:validate": "node scripts/validate-global-registry.mjs",
    "exam:form": "node scripts/generate-exam-form.mjs",
    "exam:form:dev": "node scripts/generate-exam-form.mjs --allow-draft --seed=development",
    "credential:eligibility": "node scripts/evaluate-credential-eligibility.mjs",
    "credential:test": "node scripts/test-credential-eligibility.mjs",
    "credential:issue:test": "node scripts/issue-test-credential.mjs --test",
    "credential:verify:test": "node scripts/verify-test-credential.mjs",
    "credential:issuance:test": "node scripts/test-credential-issuance.mjs",
    "credential:public": "node scripts/project-public-verification.mjs",
    "credential:public:test": "node scripts/test-public-verification-projection.mjs",
    "credential:specialist:readiness": "node scripts/report-specialist-credential-readiness.mjs",
    "credential:specialist:coverage": "node scripts/report-specialist-final-coverage.mjs --check",
    "credential:coverage": "node scripts/report-course-credential-coverage.mjs",
    "review:validate": "node scripts/validate-reviews.mjs",
    "review:queue": "node scripts/build-review-queue.mjs",
    "review:queue:check": "node scripts/build-review-queue.mjs --summary-only",
    "review:packet": "node scripts/build-review-packets.mjs",
    "review:packets:check": "node scripts/build-review-packets.mjs --summary-only",
    "review:readiness": "node scripts/report-review-readiness.mjs",
    "pilot:validate": "node scripts/validate-pilot-evidence.mjs",
    "pilot:template": "node scripts/create-pilot-evidence-template.mjs",
    "pilot:readiness": "node scripts/report-pilot-readiness.mjs",
    "itembank:readiness": "node scripts/report-item-bank-readiness.mjs",
    "runtime:test": "node scripts/test-runtime-core.mjs",
    "api:test": "node scripts/test-api-security.mjs",
    "api:failure:test": "node scripts/test-api-failure-handling.mjs",
    "persistence:test": "node scripts/test-persistence-contract.mjs",
    "credential:persistence:test": "node scripts/test-credential-persistence-writes.mjs",
    "rls:contract:test": "node scripts/test-rls-policy-contract.mjs",
    "ops:validate": "node scripts/validate-operational-controls.mjs",
    "production:readiness": "node scripts/check-production-readiness.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "release:scope:test": "node scripts/test-release-scope.mjs",
    "knowledge:validate": "node scripts/validate-knowledge-base.mjs",
    "api:dev": "node apps/api/src/server.mjs",
    "test": "npm run schema:validate && npm run validate && npm run registry:validate && npm run review:validate && npm run review:queue:check && npm run review:packets:check && npm run pilot:validate && npm run pilot:readiness && npm run exam:form:dev && npm run credential:test && npm run credential:issuance:test && npm run credential:public:test && npm run credential:specialist:readiness && npm run credential:specialist:coverage && npm run credential:coverage && npm run review:readiness && npm run itembank:readiness && npm run knowledge:validate && npm run runtime:test && npm run api:test && npm run api:failure:test && npm run persistence:test && npm run credential:persistence:test && npm run rls:contract:test && npm run ops:validate && npm run release:scope:test && npm run production:readiness"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
